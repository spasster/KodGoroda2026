# Скопируйте в .env и поправьте. Относительные пути считаются от папки backend/.

# База SQLite. Нет файла: создастся при старте.
DB_PATH=var/app.sqlite
# Папка с survey.json, signals.json и import_map.json.
SURVEY_DIR=../survey
# Откуда грузить анкеты, если база пустая: interns.xlsx и mentors.xlsx. Нет папки: старт с пустой базой.
SAMPLE_DIR=../data/sample

# Разбор комментариев: rules (словарь, без сети) или openai (OpenAI-совместимый API).
LLM_PROVIDER=rules
# Для openai. Ollama локально: http://localhost:11434/v1, из Docker: http://host.docker.internal:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
# Для Ollama не нужен.
LLM_API_KEY=

# Google Формы: ссылки на опубликованные CSV таблиц ответов (Файл → Поделиться → Опубликовать в интернете → CSV).
GSHEET_CSV_URL_INTERN=
GSHEET_CSV_URL_MENTOR=
# Как часто забирать новые строки, в секундах. 0: не опрашивать, только POST /api/sync/gsheet.
GSHEET_POLL_SECONDS=0

# Google Forms API и Drive API. OAuth 2.0 с доступом drive.file.
GOOGLE_FORMS_CLIENT_ID=
GOOGLE_FORMS_CLIENT_SECRET=
GOOGLE_FORMS_REFRESH_TOKEN=
# Два разных случайных секрета. Ключ HR вводится в разделе «Опросы».
GOOGLE_FORMS_HR_KEY=
GOOGLE_FORMS_LINK_SECRET=
# 0 отключает фоновый опрос. Ручная синхронизация доступна в кабинете HR.
GOOGLE_FORMS_POLL_SECONDS=15
